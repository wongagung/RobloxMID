# Server
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
MAX_FILE_SIZE_MB=20

# Roblox Open Cloud
# Create an API key with asset write permission.
ROBLOX_API_KEY=
ROBLOX_USER_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: asset moderation polling
ROBLOX_POLL_INTERVAL_MS=3000
ROBLOX_POLL_TIMEOUT_MS=120000
# Local uploads are temporary. Old files are cleaned automatically.
UPLOAD_RETENTION_MINUTES=60
